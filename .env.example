# Conteúdo de config/master.key (obrigatório em produção)
RAILS_MASTER_KEY=

# Caminho absoluto no HD secundário (Fedora), montado em /backup no container de backup
# Exemplo: /run/media/ramonsantos/Backup/finances
FINANCES_BACKUP_PATH=

# Intervalo entre backups (segundos). Padrão: 3600 (1 hora)
FINANCES_BACKUP_INTERVAL_SECONDS=3600

# Dias de retenção das pastas datadas no HD secundário. Padrão: 14
FINANCES_BACKUP_RETENTION_DAYS=14