# syntax=docker/dockerfile:1
# check=error=true

# Development image (SQLite, Foreman via bin/dev).
#
# Build:  docker compose build
# Run:    docker compose up
# Tests:  docker compose run --rm app bundle exec rspec

ARG RUBY_VERSION=4.0.10
FROM docker.io/library/ruby:$RUBY_VERSION-slim AS base

ARG USER_ID=1000
ARG GROUP_ID=1000

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential \
      curl \
      git \
      less \
      libjemalloc2 \
      libvips \
      libyaml-dev \
      pkg-config \
      sqlite3 \
      sudo && \
    ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle" \
    LD_PRELOAD="/usr/local/lib/libjemalloc.so" \
    RUBY_DEBUG_OPEN="true" \
    RUBY_DEBUG_HOST="0.0.0.0" \
    RUBY_DEBUG_LAZY="true"

RUN groupadd --system --gid ${GROUP_ID} rails && \
    useradd rails --uid ${USER_ID} --gid ${GROUP_ID} --create-home --shell /bin/bash && \
    echo "rails ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    mkdir -p "${BUNDLE_PATH}" /usr/local/bundle-image && \
    chown -R rails:rails /rails "${BUNDLE_PATH}" /usr/local/bundle-image

USER rails

COPY --chown=rails:rails Gemfile Gemfile.lock ./
COPY --chown=rails:rails vendor vendor

RUN bundle install && \
    rm -rf ~/.bundle/ "${BUNDLE_PATH}"/ruby/*/cache "${BUNDLE_PATH}"/ruby/*/bundler/gems/*/.git

USER root
RUN cp -a "${BUNDLE_PATH}/." /usr/local/bundle-image/ && \
    chown -R rails:rails /usr/local/bundle-image

USER rails

COPY --chown=rails:rails . .

USER root

EXPOSE 3000 12345

ENTRYPOINT ["/rails/bin/docker-entrypoint.dev"]
CMD ["./bin/dev"]