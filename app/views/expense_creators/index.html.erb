<% content_for :title, t("expense_creators.index.title") %>

<h1 class="mb-6 text-2xl font-bold text-slate-900"><%= t("expense_creators.index.title") %></h1>

<div class="mb-8 rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
  <%= form_with(url: expense_creators_path, multipart: true, class: "flex flex-wrap items-end gap-4") do |form| %>
    <div class="flex-1 min-w-[200px]">
      <label class="<%= label_class %>">Arquivo CSV</label>
      <%= file_field_tag :file, id: "csv_file", required: true, accept: ".csv,text/csv", class: input_class %>
    </div>
    <%= form.submit t("expense_creators.index.submit"), class: btn_primary %>
    <%= link_to t("expense_creators.index.download_template"), download_csv_template_expense_creators_path, class: btn_outline %>
  <% end %>
</div>

<% if @expense_creators.any? %>
  <h2 class="mb-3 text-lg font-semibold text-slate-800"><%= t("expense_creators.index.history") %></h2>
  <ul class="divide-y divide-slate-100 rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
    <% @expense_creators.each do |creator| %>
      <li class="flex items-center justify-between px-4 py-3 hover:bg-slate-50">
        <div>
          <p class="font-medium text-slate-900"><%= l(creator.date) %></p>
          <p class="text-xs text-slate-500">
            <%= t("expense_creators.show.status.#{creator.status}") %> · <%= creator.expense_creator_results_count %> linhas
          </p>
        </div>
        <%= link_to t("forms.details"), expense_creator_path(creator), class: btn_primary_xs %>
      </li>
    <% end %>
  </ul>
  <div class="mt-4 flex justify-end"><%== pagy_nav(@pagy) %></div>
<% else %>
  <p class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500"><%= t("expense_creators.index.empty") %></p>
<% end %>