<% content_for :title, t("expense_creators.show.title") %>

<% polling = @expense_creator.queued? || @expense_creator.processing? %>
<div <%= "data-controller=poll-import".html_safe if polling %>>
  <h1 class="mb-2 text-2xl font-bold text-slate-900"><%= t("expense_creators.show.title") %></h1>
  <p class="mb-6 text-sm text-slate-600">
    <%= t("expense_creators.show.status.#{@expense_creator.status}") %>
    <% if polling %>
      — <%= t("expense_creators.show.processing") %>
    <% elsif @expense_creator.failed? %>
      — <%= t("expense_creators.show.failed") %>
    <% end %>
  </p>

  <% if @expense_creator.finished? || @expense_creator.failed? %>
    <% if @expense_creator_results.any? %>
      <div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
              <tr>
                <% import_csv_column_headers.each do |header| %>
                  <th class="whitespace-nowrap px-4 py-3"><%= header %></th>
                <% end %>
                <th class="whitespace-nowrap px-4 py-3"><%= t("expense_creators.show.result_column") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% @expense_creator_results.each do |result| %>
                <tr class="hover:bg-slate-50">
                  <% result.import_row_values.each do |value| %>
                    <td class="whitespace-nowrap px-4 py-3 text-slate-700"><%= value.presence || "—" %></td>
                  <% end %>
                  <td class="whitespace-nowrap px-4 py-3">
                    <%= render "import_result_badge", result: result %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      <%= render "shared/pagination",
            pagy: @pagy,
            variant: :detached,
            show_info: false,
            leading: import_result_summary_text(@expense_creator) %>
    <% end %>
  <% end %>
</div>