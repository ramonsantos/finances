<% content_for :title, t("payment_methods.show.title") %>

<div class="mx-auto max-w-lg">
  <h1 class="mb-6 text-2xl font-bold text-slate-900"><%= t("payment_methods.show.title") %></h1>
  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <%= render "form", payment_method: @payment_method %>
    <div class="mt-4 border-t border-slate-100 pt-4">
      <%= button_to t("forms.remove"), payment_method_path(@payment_method), method: :delete, form: { data: { turbo_confirm: t("flash.confirm_destroy") } }, class: btn_danger_xs %>
    </div>
  </div>
</div>