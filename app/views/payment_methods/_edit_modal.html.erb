<%# locals: (payment_method:, open: false) %>
<% modal_control_id = "payment-method-edit-#{payment_method.id}" %>

<span class="contents" data-controller="expense-modal">
  <input
    type="checkbox"
    id="<%= modal_control_id %>"
    class="peer sr-only"
    aria-hidden="true"
    data-expense-modal-target="checkbox"
    <%= "checked" if open %>>

  <label for="<%= modal_control_id %>" class="<%= btn_primary_xs %> cursor-pointer">
    <%= t("forms.edit") %>
  </label>

  <div
    class="pointer-events-none fixed left-0 top-0 z-[200] hidden h-dvh w-dvw items-center justify-center overflow-y-auto bg-slate-900/50 p-4 text-left whitespace-normal opacity-0 backdrop-blur-sm transition-opacity duration-200 peer-checked:pointer-events-auto peer-checked:flex peer-checked:opacity-100 sm:p-6"
    role="presentation">
    <div
      class="mx-auto flex max-h-[min(90dvh,52rem)] w-full min-w-0 max-w-2xl shrink-0 flex-col rounded-2xl border border-slate-200 bg-white shadow-xl"
      role="dialog"
      aria-modal="true"
      aria-labelledby="<%= modal_control_id %>-title">
      <div class="border-b border-slate-100 px-6 py-4 sm:px-8">
        <h2 id="<%= modal_control_id %>-title" class="text-xl font-semibold text-slate-900">
          <%= t("payment_methods.show.title") %>
        </h2>
      </div>

      <div class="overflow-y-auto px-6 py-5 sm:px-8">
        <%= render "form",
              payment_method: payment_method,
              modal: true,
              modal_control_id: modal_control_id %>
      </div>
    </div>
  </div>
</span>