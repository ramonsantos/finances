<% content_for :title, t("payment_methods.index.title") %>
<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-slate-900"><%= t("payment_methods.index.title") %></h1>
  <label for="payment-method-new-modal" class="<%= btn_primary_sm %> cursor-pointer">
    <%= t("payment_methods.index.new") %>
  </label>
</div>

<% if @payment_methods.any? %>
  <div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500">
        <tr>
          <th class="px-4 py-3"><%= t("activerecord.attributes.payment_method.name") %></th>
          <th class="px-4 py-3 text-right"><%= t("payment_methods.index.expenses_column") %></th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @payment_methods.each do |payment_method| %>
          <% editable_payment_method = @open_edit_payment_method_id == payment_method.id ? @payment_method : payment_method %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium"><%= payment_method.name %></td>
            <td class="px-4 py-3 text-right tabular-nums"><%= payment_method.expenses_count %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <div class="inline-flex flex-wrap items-center justify-end gap-2">
                <%= render "edit_modal",
                      payment_method: editable_payment_method,
                      open: @open_edit_payment_method_id == payment_method.id %>
                <% if payment_method.expenses_count.zero? %>
                  <%= render "shared/confirm_delete", action_url: payment_method_path(payment_method), record_name: payment_method.name %>
                <% else %>
                  <span class="inline-flex cursor-not-allowed items-center rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-400" aria-disabled="true" title="<%= t('payment_methods.destroy.destroy_failed') %>"><%= t("forms.remove") %></span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">
    <p><%= t("payment_methods.index.empty") %></p>
    <label for="payment-method-new-modal" class="<%= btn_primary_sm %> mt-4 inline-flex cursor-pointer">
      <%= t("payment_methods.index.new") %>
    </label>
  </div>
<% end %>

<%= render "new_modal", payment_method: @new_payment_method, open: @open_payment_method_modal %>