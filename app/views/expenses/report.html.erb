<% content_for :title, t("expenses.report.title", month: expense_month_label(@current_expense_month)) %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-bold text-slate-900">
    <%= t("expenses.report.title", month: expense_month_label(@current_expense_month)) %>
  </h1>
  <div class="flex flex-wrap gap-2">
    <%= link_to expense_month_label(@current_expense_month, :prev), report_expenses_path(expense_month: expense_month_param(@current_expense_month, :prev)), class: btn_outline %>
    <%= link_to t("expenses.report.to_index"), expenses_path(expense_month: expense_month_param(@current_expense_month)), class: btn_primary_sm %>
    <%= link_to expense_month_label(@current_expense_month, :next), report_expenses_path(expense_month: expense_month_param(@current_expense_month, :next)), class: btn_outline %>
  </div>
</div>

<% if @expenses_grouped_data.any? %>
  <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
    <% @expenses_grouped_data.each do |group| %>
      <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
        <h2 class="text-lg font-semibold text-slate-900"><%= group[:expense_group_name] %></h2>
        <div class="mt-4 space-y-4">
          <% group[:categories].each do |category| %>
            <div>
              <div class="mb-1 flex justify-between text-sm">
                <span><%= category[:name] %></span>
                <span class="tabular-nums text-slate-600"><%= number_with_precision(category[:percent_total], precision: 2) %>%</span>
              </div>
              <div class="h-2 overflow-hidden rounded-full bg-slate-100">
                <div class="h-full rounded-full bg-emerald-500" style="width: <%= category[:percent_total] %>%"></div>
              </div>
            </div>
          <% end %>
        </div>
        <p class="mt-4 border-t border-slate-100 pt-3 text-right text-sm font-semibold tabular-nums text-slate-900">
          <%= t("expenses.report.total") %>: <%= formatted_money(group[:total]) %>
        </p>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500"><%= t("expenses.index.empty") %></p>
<% end %>