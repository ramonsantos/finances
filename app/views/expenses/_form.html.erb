<%= form_with(model: expense, class: "space-y-5", data: { controller: "money-input", action: "submit->money-input#beforeSubmit" }) do |form| %>
  <% if expense.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <%= expense.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="space-y-5">
    <div>
      <%= form.label :date, class: label_class %>
      <%= form.date_field :date, required: true, class: input_class, value: expense.date %>
    </div>

    <div>
      <%= form.label :description, class: label_class %>
      <%= form.text_field :description, required: true, class: input_class %>
    </div>

    <div data-money-input-target="wrapper">
      <%= form.label :amount, class: label_class %>
      <%= form.text_field :amount,
            required: true,
            class: "#{input_class} tabular-nums",
            value: form_amount_value(expense.amount),
            placeholder: "R$ 0,00",
            data: {
              money_input_target: "input",
              action: "input->money-input#input keydown->money-input#keydown paste->money-input#paste"
            } %>
    </div>

    <%= render "shared/searchable_select",
          form: form,
          attribute: :expense_category_id,
          label: "Categoria",
          options: @expense_categories,
          selected: expense.expense_category_id %>

    <%= render "shared/searchable_select",
          form: form,
          attribute: :payment_method_id,
          label: "Forma de pagamento",
          options: @payment_methods,
          selected: expense.payment_method_id %>

    <%= render "shared/form_switch",
          form: form,
          attribute: :essential,
          label: "Essencial",
          hint: t("expenses.form.essential_hint") %>

    <%= render "shared/form_switch",
          form: form,
          attribute: :fixed,
          label: "Despesa fixa",
          hint: t("expenses.form.fixed_hint") %>

    <div>
      <%= form.label :remark, "Observação", class: label_class %>
      <%= form.text_field :remark, class: input_class %>
    </div>
  </div>

  <%= hidden_field_tag :expense_month, @current_expense_month %>

  <div class="flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:justify-end">
    <% if local_assigns[:modal] %>
      <button type="button" data-action="expense-modal#close" class="<%= btn_outline %> w-full sm:w-auto">
        <%= t("forms.cancel") %>
      </button>
    <% end %>

    <%= form.submit t("forms.save"), class: "#{btn_primary} w-full sm:w-auto" %>
  </div>
<% end %>