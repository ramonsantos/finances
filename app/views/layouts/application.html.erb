<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || t("layout.app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%= favicon_link_tag asset_path('favicon.svg') %>
  </head>

  <body class="min-h-full antialiased text-slate-800">
    <div class="flex min-h-screen">
      <%= render "layouts/sidebar" %>

      <div class="flex flex-1 flex-col md:pl-64">
        <%= render "layouts/mobile_nav" %>

        <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
          <%= yield %>
        </main>

        <footer class="border-t border-slate-200 px-6 py-4 text-center text-sm text-slate-500">
          <%= t("layout.footer", year: current_year) %>
        </footer>
      </div>
    </div>

    <%= render "shared/flash" %>
  </body>
</html>
