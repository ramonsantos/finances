<%= form_with(model: expense_category, class: "space-y-5") do |form| %>
  <% if expense_category.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <%= expense_category.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="space-y-5">
    <div>
      <%= required_form_label(form, :name) %>
      <%= form.text_field :name, required: true, class: input_class %>
    </div>

    <div>
      <%= form.label :description, class: label_class %>
      <%= form.text_field :description, class: input_class %>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:justify-end">
    <% if local_assigns[:modal] %>
      <button type="button" data-action="expense-modal#close" class="<%= btn_outline %> w-full sm:w-auto">
        <%= t("forms.cancel") %>
      </button>
    <% else %>
      <%= link_to t("forms.cancel"), cancel_path, class: "#{btn_outline} w-full justify-center sm:w-auto" %>
    <% end %>

    <%= form.submit t("forms.save"), class: "#{btn_primary} w-full sm:w-auto" %>
  </div>
<% end %>