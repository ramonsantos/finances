<div class="mx-auto max-w-lg">
  <h1 class="mb-6 text-2xl font-bold"><%= t("expense_categories.show.title") %></h1>
  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <%= render "form", expense_category: @expense_category %>
    <div class="mt-4 border-t pt-4">
      <%= button_to t("forms.remove"), expense_category_path(@expense_category), method: :delete, form: { data: { turbo_confirm: t("flash.confirm_destroy") } }, class: btn_danger_xs %>
    </div>
  </div>
</div>