<% content_for :title, t("expense_categories.index.title") %>
<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-slate-900"><%= t("expense_categories.index.title") %></h1>
  <%= link_to t("expense_categories.index.new"), new_expense_category_path, class: btn_primary_sm %>
</div>

<% if @expense_categories.any? %>
  <div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500">
        <tr>
          <th class="px-4 py-3">Nome</th>
          <th class="px-4 py-3">Descrição</th>
          <th class="px-4 py-3 text-right">Despesas</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @expense_categories.each do |category| %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium"><%= category.name %></td>
            <td class="px-4 py-3 text-slate-600"><%= category.description %></td>
            <td class="px-4 py-3 text-right tabular-nums"><%= category.expenses_count %></td>
            <td class="px-4 py-3 text-right">
              <%= link_to t("forms.edit"), expense_category_path(category), class: btn_primary_xs %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500"><%= t("expense_categories.index.empty") %></p>
<% end %>