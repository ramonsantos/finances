<% content_for :title, t("expense_categories.index.title") %>
<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-slate-900"><%= t("expense_categories.index.title") %></h1>
  <label for="expense-category-new-modal" class="<%= btn_primary_sm %> cursor-pointer">
    <%= t("expense_categories.index.new") %>
  </label>
</div>

<% if @expense_categories.any? %>
  <div class="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
    <table class="min-w-full text-sm">
      <thead class="bg-slate-50 text-left text-xs font-semibold uppercase text-slate-500">
        <tr>
          <th class="px-4 py-3">Nome</th>
          <th class="px-4 py-3">Descrição</th>
          <th class="px-4 py-3 text-right">Despesas</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @expense_categories.each do |category| %>
          <% editable_category = @open_edit_expense_category_id == category.id ? @expense_category : category %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 font-medium"><%= category.name %></td>
            <td class="px-4 py-3 text-slate-600"><%= category.description %></td>
            <td class="px-4 py-3 text-right tabular-nums"><%= category.expenses_count %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <div class="inline-flex flex-wrap items-center justify-end gap-2">
                <%= render "edit_modal",
                      category: editable_category,
                      open: @open_edit_expense_category_id == category.id %>
                <% if category.expenses_count.zero? %>
                  <%= render "shared/confirm_delete", action_url: expense_category_path(category), record_name: category.name %>
                <% else %>
                  <span class="inline-flex cursor-not-allowed items-center rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-400" aria-disabled="true" title="<%= t('expense_categories.destroy.destroy_failed') %>"><%= t("forms.remove") %></span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">
    <p><%= t("expense_categories.index.empty") %></p>
    <label for="expense-category-new-modal" class="<%= btn_primary_sm %> mt-4 inline-flex cursor-pointer">
      <%= t("expense_categories.index.new") %>
    </label>
  </div>
<% end %>

<%= render "new_modal", expense_category: @new_expense_category, open: @open_expense_category_modal %>